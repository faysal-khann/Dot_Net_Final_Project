@model BLL.DTOs.EmployeeDashboardDTO
@{
    ViewData["Title"] = "Employee Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Welcome, @Model.EmployeeName!</h2>
        <span class="badge bg-secondary fs-6">Role: @Model.Position</span>
    </div>
    
    @if (Model.ApprovalStatus == "Pending")
    {
        <div class="alert alert-warning">Your account is pending approval by the Manager. You cannot perform tasks yet.</div>
    }

    <!-- Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">

        @* ---------------- MANAGER DASHBOARD ---------------- *@
        @if (Model.Position == "Manager")
        {
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm h-100 border-primary">
                    <div class="card-header bg-primary text-white">Pending Employee Approvals</div>
                    <div class="card-body">
                        @if (!Model.PendingEmployees.Any())
                        {
                            <p class="text-muted">No pending approvals.</p>
                        }
                        <ul class="list-group">
                            @foreach (var emp in Model.PendingEmployees)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>@emp.Name (@emp.Position)</span>
                                    <form asp-action="ApproveEmployee" method="post">
                                        <input type="hidden" name="employeeId" value="@emp.EmployeeId" />
                                        <button type="submit" class="btn btn-sm btn-success">Approve</button>
                                    </form>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-dark text-white">Hotel Status</div>
                    <div class="card-body">
                        <p><strong>Available Rooms:</strong> @Model.AvailableRooms</p>
                        <p><strong>Occupied Rooms:</strong> @Model.OccupiedRooms</p>
                        <p><strong>Total Guests Arriving/Leaving:</strong> @Model.TotalGuestsToday</p>
                    </div>
                </div>
            </div>
        }

        @* ---------------- CLEANER / TECHNICIAN DASHBOARD ---------------- *@
        @if (Model.Position == "Cleaner" || Model.Position == "Technician")
        {
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-dark text-white">
                        My Tasks (@(Model.Position == "Cleaner" ? "Rooms to Clean" : "Rooms to Fix"))
                    </div>
                    <div class="card-body">
                        @if (!Model.Tasks.Any())
                        {
                            <p class="text-muted">No pending tasks. Great job!</p>
                        }
                        <ul class="list-group">
                            @foreach (var task in Model.Tasks)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <strong>Room @task.RoomNumber</strong>
                                    
                                    <div class="btn-group">
                                        @if (Model.Position == "Cleaner")
                                        {
                                            <form asp-action="MarkRoomCleaned" method="post" class="d-inline">
                                                <input type="hidden" name="roomId" value="@task.RoomId" />
                                                <button type="submit" class="btn btn-sm btn-success">Mark Cleaned</button>
                                            </form>
                                            <form asp-action="ReportMaintenance" method="post" class="d-inline ms-1">
                                                <input type="hidden" name="roomId" value="@task.RoomId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Report Fix Needed">⚠️</button>
                                            </form>
                                        }
                                        else if (Model.Position == "Technician")
                                        {
                                            <form asp-action="MarkMaintenanceDone" method="post" class="d-inline">
                                                <input type="hidden" name="roomId" value="@task.RoomId" />
                                                <button type="submit" class="btn btn-sm btn-success">Mark Fixed (Available)</button>
                                            </form>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }

        @* ---------------- CHEF DASHBOARD ---------------- *@
        @if (Model.Position == "Chef")
        {
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm h-100 border-warning">
                    <div class="card-header bg-warning text-dark">Kitchen & Dining Overview</div>
                    <div class="card-body">
                        <h4 class="text-center mb-4">Guests Transitioning Today: <strong>@Model.TotalGuestsToday</strong></h4>
                        <p class="text-muted text-center">Use this number to plan breakfast and room service capacity.</p>
                    </div>
                </div>
            </div>
        }

        @* ---------------- READ ONLY SCHEDULE (FOR EVERYONE EXCEPT MANAGER) ---------------- *@
        @if (Model.Position != "Manager")
        {
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-info text-white">Today's Schedule (Read-Only)</div>
                    <div class="card-body">
                        <h6>Check-Outs</h6>
                        <ul class="list-group mb-3">
                            @foreach (var co in Model.TodaysCheckOuts)
                            {
                                <li class="list-group-item">Room @co.RoomNumber - @co.GuestName</li>
                            }
                        </ul>
                        <h6>Check-Ins</h6>
                        <ul class="list-group">
                            @foreach (var ci in Model.TodaysCheckIns)
                            {
                                <li class="list-group-item">Room @ci.RoomNumber - @ci.GuestName</li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }

    </div>
</div>