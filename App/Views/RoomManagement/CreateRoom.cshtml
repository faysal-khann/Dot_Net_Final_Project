@model BLL.DTOs.RoomDTO
@using System.Linq

@{
    ViewData["Title"] = "Add New Room";
    var roomTypes = ViewBag.RoomTypes as List<BLL.DTOs.RoomTypeDTO>;
    var existingRooms = ViewBag.ExistingRooms as List<BLL.DTOs.RoomDTO>;
}

<div class="container-fluid mt-4">
    <h2>Add New Room</h2>
    <hr />

    <div class="row">
        <!-- LEFT COLUMN: ADD ROOM FORM -->
        <div class="col-md-4">
            <div class="card shadow-sm border-primary">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Room Details</h5>
                </div>
                <div class="card-body">
                    <form asp-action="CreateRoom" method="post">
                        
                        <div class="form-group mb-3">
                            <label asp-for="RoomNumber" class="font-weight-bold">Room Number</label>
                            <input asp-for="RoomNumber" class="form-control" placeholder="e.g. 101, 205A" required />
                            <span asp-validation-for="RoomNumber" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="RoomTypeId" class="font-weight-bold">Room Type</label>
                            <select asp-for="RoomTypeId" class="form-control" required>
                                <option value="">-- Select Room Type --</option>
                                @if (roomTypes != null)
                                {
                                    @foreach (var type in roomTypes)
                                    {
                                        <option value="@type.RoomTypeId">@type.TypeName (Capacity: @type.Capacity)</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="RoomTypeId" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Price" class="font-weight-bold">Price Per Night ($)</label>
                            <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" required />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Status" class="font-weight-bold">Initial Status</label>
                            <select asp-for="Status" class="form-control" required>
                                <option value="Available">Available</option>
                                <option value="Maintenance">Maintenance</option>
                                <option value="Occupied">Occupied</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-primary">Save Room</button>
                            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: REFERENCE TABLE GROUPED BY TYPE -->
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white d-flex justify-content-between">
                    <h5 class="mb-0">Existing Rooms Reference</h5>
                    <small>Check this to name your next room efficiently</small>
                </div>
                <div class="card-body" style="max-height: 600px; overflow-y: auto;">
                    
                    @if (existingRooms != null && existingRooms.Any())
                    {
                        // Group the rooms by their TypeName
                        var groupedRooms = existingRooms.GroupBy(r => r.RoomTypeName);

                        foreach (var group in groupedRooms)
                        {
                            <div class="mb-4">
                                <h5 class="text-info border-bottom pb-2">@group.Key</h5>
                                <table class="table table-sm table-bordered table-striped">
                                    <thead class="thead-light">
                                        <tr>
                                            <th style="width: 30%">Room No.</th>
                                            <th style="width: 30%">Price</th>
                                            <th style="width: 40%">Current Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var room in group.OrderBy(r => r.RoomNumber))
                                        {
                                            <tr>
                                                <td><strong>@room.RoomNumber</strong></td>
                                                <td>$@room.Price</td>
                                                <td>
                                                    @if (room.Status == "Available")
                                                    {
                                                        <span class="text-success">@room.Status</span>
                                                    }
                                                    else if (room.Status == "Maintenance")
                                                    {

                                                        <span class="text-danger">@room.Status</span>
                                                    }
                                                    else
                                                    {

                                                        <span class="text-warning">@room.Status</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No rooms exist in the database yet. Add your first one on the left!</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}