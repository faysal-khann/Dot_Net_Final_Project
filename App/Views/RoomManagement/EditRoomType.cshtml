@model BLL.DTOs.RoomTypeDTO

@{
    ViewData["Title"] = "Edit Room Type";
}

<div class="col-md-6">
    <h2>Edit Room Type</h2>
    <hr />

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="EditRoomType" method="post">
                <!-- Hidden ID is required to update the correct record! -->
                <input type="hidden" asp-for="RoomTypeId" />

                <div class="form-group mb-3">
                    <label asp-for="TypeName" class="font-weight-bold">Room Type Name</label>
                    <input asp-for="TypeName" class="form-control" required />
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Capacity" class="font-weight-bold">Capacity (People)</label>
                    <input asp-for="Capacity" type="number" min="1" class="form-control" required />
                </div>

                <button type="submit" class="btn btn-success">Update Room Type</button>
                <a asp-action="RoomTypes" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>