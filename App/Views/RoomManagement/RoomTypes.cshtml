@model IEnumerable<BLL.DTOs.RoomTypeDTO>

@{
    ViewData["Title"] = "Manage Room Types";
}

<h2>Admin: Manage Room Types</h2>
<hr />

<div class="mb-3">
    <a asp-action="CreateRoomType" class="btn btn-success">Add New Room Type</a>
    <a asp-action="Index" class="btn btn-secondary">Back to Rooms</a>
</div>

<div class="card shadow-sm col-md-8 px-0">
    <table class="table table-bordered table-striped mb-0">
        <thead class="thead-dark">
            <tr>
                <th>ID</th>
                <th>Type Name</th>
                <th>Capacity</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var type in Model)
                {
                    <tr>
                        <td>@type.RoomTypeId</td>
                        <td><strong>@type.TypeName</strong></td>
                        <td>@type.Capacity People</td>
                        <td>
                            <a asp-action="EditRoomType" asp-route-id="@type.RoomTypeId" class="btn btn-sm btn-info">Edit</a>
                            <form asp-action="DeleteRoomType" asp-route-id="@type.RoomTypeId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this room type?');">
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="4" class="text-center">No Room Types found.</td></tr>
            }
        </tbody>
    </table>
</div>
