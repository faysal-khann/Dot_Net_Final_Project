@model BLL.DTOs.RoomDTO

@{
    ViewData["Title"] = "Edit Room";
    // Grab the room types from the ViewBag for the dropdown
    var roomTypes = ViewBag.RoomTypes as List<BLL.DTOs.RoomTypeDTO>;
}

<div class="container mt-4">
    <h2>Edit Room - @Model.RoomNumber</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm border-info">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Update Room Details</h5>
                </div>
                <div class="card-body">
                    <form asp-action="EditRoom" method="post">
                        
                        <!-- CRITICAL: Hidden field so the POST action knows which room to update -->
                        <input type="hidden" asp-for="RoomId" />
                        
                        <div class="form-group mb-3">
                            <label asp-for="RoomNumber" class="font-weight-bold">Room Number</label>
                            <input asp-for="RoomNumber" class="form-control" required />
                            <span asp-validation-for="RoomNumber" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="RoomTypeId" class="font-weight-bold">Room Type</label>
                            <select asp-for="RoomTypeId" class="form-control" required>
                                <option value="">-- Select Room Type --</option>
                                @if (roomTypes != null)
                                {
                                    @foreach (var type in roomTypes)
                                    {
                                        <option value="@type.RoomTypeId">@type.TypeName (Capacity: @type.Capacity)</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="RoomTypeId" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Price" class="font-weight-bold">Price Per Night ($)</label>
                            <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" required />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Status" class="font-weight-bold">Status</label>
                            <select asp-for="Status" class="form-control" required>
                                <option value="Available">Available</option>
                                <option value="Maintenance">Maintenance</option>
                                <option value="Occupied">Occupied</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-success">Update Room</button>
                            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}