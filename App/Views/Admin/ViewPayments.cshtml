@model IEnumerable<BLL.DTOs.PaymentDTO>

@{
    ViewData["Title"] = "All Payments";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Payment History</h2>
        <a asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
    </div>
    <hr />

    <div class="card shadow-sm border-success">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">All Customer Payments</h5>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="thead-dark">
                    <tr>
                        <th>Payment ID</th>
                        <th>Customer Name</th>
                        <th>Room No.</th>
                        <th>Amount</th>
                        <th>Method</th>
                        <th>Payment Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var payment in Model)
                        {
                            <tr>
                                <td>#@payment.PaymentId</td>
                                <td><strong>@payment.CustomerName</strong></td>
                                <td>Room @payment.RoomNumber</td>
                                <td class="text-success font-weight-bold">$@payment.Amount</td>
                                <td>
                                    @if (payment.Method == "Card")
                                    {
                                        <span ><i class="fas fa-credit-card"></i> Card</span>
                                    }
                                    else
                                    {

                                        <span ><i class="fas fa-money-bill-wave"></i> Cash</span>
                                    }
                                </td>
                                <td>@payment.PaymentDate.ToShortDateString()</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No payments found in the system.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>