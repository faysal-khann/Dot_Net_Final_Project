@model BLL.DTOs.DashboardDTO

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid mt-4">
    <h1 class="mb-4">Admin Dashboard</h1>

    <!-- ACTIONABLE ALERTS -->
    @if (Model.PendingEmployeeApprovals > 0)
    {
        <div class="alert alert-warning d-flex justify-content-between align-items-center">
            <span><strong>Attention:</strong> You have @Model.PendingEmployeeApprovals employee(s) waiting for approval.</span>
            <a asp-action="PendingEmployees" asp-controller="Admin" class="btn btn-sm btn-warning">Review Now</a>
        </div>
    }

    <!-- ROW 1: KEY ANALYTICS (Beyond CRUD Feature) -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-white bg-success mb-3 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Revenue Today</h5>
                    <h2>$@Model.RevenueToday.ToString("0.00")</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-primary mb-3 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Revenue This Month</h5>
                    <h2>$@Model.RevenueThisMonth.ToString("0.00")</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-info mb-3 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Current Occupancy Rate</h5>
                    <h2>@Model.OccupancyRate%</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- ROW 2: RESERVATION SUMMARY & REPORTS -->
    <div class="row">
        <!-- Reservation Status Summary -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-dark text-white">
                    <strong>Reservation Status Summary</strong>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Confirmed
                            <span class="badge badge-success badge-pill" style="font-size: 1.1em;">@Model.ConfirmedReservations</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Pending
                            <span class="badge badge-warning badge-pill" style="font-size: 1.1em;">@Model.PendingReservations</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Cancelled
                            <span class="badge badge-danger badge-pill" style="font-size: 1.1em;">@Model.CancelledReservations</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Custom Revenue Report Generator -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-dark text-white">
                    <strong>Generate Revenue Report</strong>
                </div>
                <div class="card-body">
                    <p class="text-muted">Select a date range to generate a detailed revenue breakdown.</p>
                    <form asp-action="RevenueReport" asp-controller="Admin" method="get">
                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label>Start Date</label>
                                <input type="date" name="startDate" class="form-control" required />
                            </div>
                            <div class="form-group col-md-6">
                                <label>End Date</label>
                                <input type="date" name="endDate" class="form-control" required />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 mt-2">Generate Report</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- ROW 3: QUICK LINKS TO CRUD MODULES -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white">
                    <strong>Quick Management Links</strong>
                </div>
                <div class="card-body">
                    <a href="#" class="btn btn-outline-dark m-1">Manage Rooms & Types</a>
                    <a href="#" class="btn btn-outline-dark m-1">Manage Users & Employees</a>
                    <a href="#" class="btn btn-outline-dark m-1">View All Payments</a>
                </div>
            </div>
        </div>
    </div>
</div>